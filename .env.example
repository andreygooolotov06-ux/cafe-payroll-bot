# Токен бота від @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Вкажіть або Telegram ID власниці, або її @username (можна через кому)
OWNER_IDS=
OWNER_USERNAMES=anya_username

# Часовий пояс кафе (для точного визначення "Сьогодні" та "Вчора")
TIMEZONE=Europe/Kyiv

# Локальна база даних SQLite (використовується, якщо DATABASE_URL порожній)
DB_PATH=data/cafe_payroll.db

# Хмарна PostgreSQL (Neon / Render). Якщо задано — використовується замість SQLite:
# postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Mini App (веб-кабінет усередині Telegram)
MINIAPP_HOST=127.0.0.1
MINIAPP_PORT=8080
# У хмарі Render підставляє RENDER_EXTERNAL_URL автоматично
MINIAPP_URL=
MINIAPP_AUTO_TUNNEL=true

# Режим роботи бота: auto | polling | webhook
# (auto: webhook у хмарі з HTTPS URL, polling локально)
BOT_MODE=auto
WEBHOOK_PATH=/telegram/webhook
# Необов'язково: секрет для перевірки запитів від Telegram (інакше згенерується з BOT_TOKEN)
WEBHOOK_SECRET=
